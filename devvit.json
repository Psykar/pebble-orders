{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pebble-orders",
  "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true
  },
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "dashboard": {
        "entry": "dashboard.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "[pebble-orders] New Post",
        "description": "Create a new Pebble shipping dashboard post.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/new-post"
      },
      {
        "label": "[pebble-orders] Refresh Reports",
        "description": "Re-read the shipping mega thread now.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/on/menu/refresh"
      }
    ]
  },
  "settings": {
    "subreddit": {
      "megaThread": {
        "type": "string",
        "label": "Shipping mega thread",
        "helpText": "Link or post ID of the thread whose top-level comments are shipping reports. Takes effect on the next dashboard view.",
        "placeholder": "https://www.reddit.com/r/pebble/comments/1sjk3c7/",
        "defaultValue": "https://www.reddit.com/r/pebble/comments/1sjk3c7/shipping_mega_thread",
        "validationEndpoint": "/internal/settings/validate-mega-thread"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scheduler": {
    "tasks": {
      "refresh-reports": {
        "endpoint": "/internal/scheduler/refresh-reports",
        "cron": "*/15 * * * *"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "pebble_orders_dev"
  }
}
